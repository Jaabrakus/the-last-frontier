extends SceneTree
## Every UiFonts font writes Vietnamese (the owner, 2026-10-05: English text, names kept in their Vietnamese spelling).
## Fonts only, no scene. Headless:
##
##   Godot --headless --path . -s tests/thuyvan/test_vietnamese_glyphs.gd
##
##   letters    the 134 precomposed Vietnamese letters (12 vowels x 6 tones less the 6 plain ones, and đ; both cases)
##   fonts      Font.has_char for every letter, the game's punctuation and every character in data/thuyvan/*.json, on
##              serif, sans and mono at the weights the UI asks for, as UiFonts gives them (with fallbacks)
##   first face the same on each role's first installed font alone (no fallbacks): the list's own pick covers it all
##   theme      assets/ui/thuyvan_theme.tres sets UiFonts' shipped face (a FontVariation) over the same names as UiFonts,
##              covers the same characters, and its line
##              spacing is at least UiFonts.line_gap at its sizes
## The cmap check behind the lists is tools/fonts/font_cmap_check.py (it reads the font files; this asks the engine).
## Ends with "VIETNAMESE GLYPHS TEST PASSED (<n> checks)" or "VIETNAMESE GLYPHS TEST FAILED (<f> of <n>)".

const DATA_DIR := "res://data/thuyvan/"
const THEME := "res://assets/ui/thuyvan_theme.tres"
## Generated by tools/fonts/font_cmap_check.py (vietnamese_letters): lower case then upper, đ and Đ last of each.
const LETTERS := "àáảãạăằắẳẵặâầấẩẫậèéẻẽẹêềếểễệìíỉĩịòóỏõọôồốổỗộơờớởỡợùúủũụưừứửữựỳýỷỹỵđ" \
		+ "ÀÁẢÃẠĂẰẮẲẴẶÂẦẤẨẪẬÈÉẺẼẸÊỀẾỂỄỆÌÍỈĨỊÒÓỎÕỌÔỒỐỔỖỘƠỜỚỞỠỢÙÚỦŨỤƯỪỨỬỮỰỲÝỶỸỴĐ"
## Curly quotes, dashes, ellipsis, middle dot, section sign (font_cmap_check.PUNCT).
const PUNCT := "‘’“”–—…·§"
## The weights the UI asks for: [role, weight, italic].
const ASKS := [["serif", 500, false], ["serif", 700, false], ["serif", 500, true], ["sans", 500, false],
		["sans", 700, false], ["sans", 400, false], ["mono", 400, false]]

var checks := 0
var fails: Array[String] = []


func _initialize() -> void:
	UiFonts.reset()
	var data := _data_chars()
	_letters()
	_expect(data.length() > 40 and "Đ" in data and "ơ" in data,
			"data: %d characters gathered from %s (Đ and ơ among them)" % [data.length(), DATA_DIR])
	var want := {"letters": LETTERS, "punct": PUNCT, "data": data}
	_fonts(want)
	_first_faces(want)
	_theme(want)
	if fails.is_empty():
		print("VIETNAMESE GLYPHS TEST PASSED (%d checks)" % checks)
	else:
		for f in fails:
			print("FAIL: ", f)
		print("VIETNAMESE GLYPHS TEST FAILED (%d of %d)" % [fails.size(), checks])
	quit(0 if fails.is_empty() else 1)


func _expect(ok: bool, what: String) -> void:
	checks += 1
	print(("  ok   " if ok else "  FAIL ") + what)
	if not ok:
		fails.append(what)


func _letters() -> void:
	var seen := {}
	var ascii := false
	for i in LETTERS.length():
		seen[LETTERS.unicode_at(i)] = true
		ascii = ascii or LETTERS.unicode_at(i) < 128
	_expect(LETTERS.length() == 134 and seen.size() == 134 and not ascii,
			"letters: 134 distinct precomposed letters, none plain ASCII (%d, %d distinct)" % [LETTERS.length(), seen.size()])
	_expect("đ" in LETTERS and "Đ" in LETTERS and "ở" in LETTERS and "Ặ" in LETTERS and "ỹ" in LETTERS,
			"letters: đ, Đ and the stacked and hooked tones are there")


## Every character of every key and string value in the canon files, once each (control characters left out).
func _data_chars() -> String:
	var seen := {}
	var d := DirAccess.open(DATA_DIR)
	if d:
		for f in d.get_files():
			if f.ends_with(".json"):
				var fa := FileAccess.open(DATA_DIR + f, FileAccess.READ)
				_walk(JSON.parse_string(fa.get_as_text()) if fa else null, seen)
	var out := ""
	for c: int in seen:
		out += String.chr(c)
	return out


func _walk(v: Variant, seen: Dictionary) -> void:
	if v is String:
		var s: String = v
		for i in s.length():
			if s.unicode_at(i) >= 0x20:
				seen[s.unicode_at(i)] = true
	elif v is Dictionary:
		for k: Variant in v:
			_walk(String(k), seen)
			_walk(v[k], seen)
	elif v is Array:
		for x: Variant in v:
			_walk(x, seen)


## The characters of each set the font lacks ("" when it has them all).
func _missing(f: Font, want: Dictionary) -> Dictionary:
	var out := {}
	for k: String in want:
		var s: String = want[k]
		var m := ""
		for i in s.length():
			if s.unicode_at(i) != 0x20 and not f.has_char(s.unicode_at(i)):
				m += s[i]
		if not m.is_empty():
			out[k] = m
	return out


func _fonts(want: Dictionary) -> void:
	for a: Array in ASKS:
		var f := UiFonts.font(a[0], a[1], a[2])
		var miss := _missing(f, want)
		_expect(f != null and miss.is_empty(), "fonts: %s %d%s (%s, %s) has every letter, mark and data character %s"
				% [a[0], a[1], " italic" if a[2] else "", f.get_class() if f else "null", f.get_font_name() if f else "",
				"" if miss.is_empty() else str(miss)])
	_expect(UiFonts.serif() == UiFonts.serif() and UiFonts.sans(700) != UiFonts.sans(500),
			"fonts: cached per role and weight")
	_expect(UiFonts.serif() is SystemFont or UiFonts.serif() is FontVariation,
			"fonts: a SystemFont list, or a shipped family over one (%s)" % UiFonts.serif().get_class())


## Each role's first installed name alone: the list's pick covers everything without leaning on the engine's font.
func _first_faces(want: Dictionary) -> void:
	for role in ["serif", "sans", "mono"]:
		var bare := UiFonts.system(role, 500 if role != "mono" else 400)
		bare.fallbacks = []
		var face := bare.get_font_name()
		var miss := _missing(bare, want)
		_expect(not face.is_empty() and face in UiFonts.names(role) and miss.is_empty(),
				"first face: %s resolves to %s from its list, alone covering everything %s"
				% [role, face if face else "(none installed)", "" if miss.is_empty() else str(miss)])


func _theme(want: Dictionary) -> void:
	var th := load(THEME) as Theme
	_expect(th != null, "theme: %s loads" % THEME)
	if th == null:
		return
	var fonts := {"sans": th.default_font, "serif": th.get_font("font", "TitleLabel"),
			"mono": th.get_font("font", "MonoLabel")}
	for role: String in fonts:
		# a shipped face (FontVariation, UiFonts.BUNDLED) over the role's SystemFont list: its face alone covers
		# everything, and its first fallback is the list
		var v := fonts[role] as FontVariation
		if v:
			var face := v.base_font as FontFile
			var vmiss := _missing(face, want) if face else {"face": "(none)"}
			_expect(face != null and String(UiFonts.BUNDLED.get(role, "")) != ""
					and face.resource_path.begins_with(UiFonts.BUNDLED_DIR + String(UiFonts.BUNDLED[role]) + "/")
					and vmiss.is_empty(), "theme: %s font's shipped face %s is UiFonts' %s family and covers everything %s"
					% [role, face.resource_path.get_file() if face else "(none)", role, "" if vmiss.is_empty() else str(vmiss)])
		var f := (v.fallbacks[0] if v and not v.fallbacks.is_empty() else fonts[role]) as SystemFont
		_expect(f != null and Array(f.font_names) == UiFonts.names(role),
				"theme: %s font lists UiFonts' %s names %s" % [role, role, str(f.font_names) if f else "(not a SystemFont)"])
		if f:
			var miss := _missing(f, want)
			_expect(miss.is_empty(), "theme: %s font (%s) covers everything %s"
					% [role, f.get_font_name(), "" if miss.is_empty() else str(miss)])
	var sizes := {"sans": th.default_font_size, "serif": th.get_font_size("font_size", "TitleLabel"),
			"mono": th.get_font_size("font_size", "MonoLabel")}
	var spacing := {"sans": th.get_constant("line_spacing", "Label"),
			"serif": th.get_constant("line_spacing", "TitleLabel"),
			"mono": th.get_constant("line_spacing", "MonoLabel")}
	for role: String in sizes:
		_expect(int(spacing[role]) >= UiFonts.line_gap(role, int(sizes[role])),
				"theme: %s line spacing %d >= the tone-mark gap %d at %d px"
				% [role, spacing[role], UiFonts.line_gap(role, int(sizes[role])), sizes[role]])
	_expect(th.get_type_variation_base("TitleLabel") == &"Label" and th.get_type_variation_base("MonoLabel") == &"Label",
			"theme: TitleLabel and MonoLabel are Label variations")
