{
 "format": "frontier-household-jobs",
 "version": 1,
 "summary": "The household's work as a list (JobBook reads it; SpouseCore and every other worker run it). A job takes pack kinds (inputs) from the household store and puts pack kinds (outputs) back, so the chain is derived: a job whose input is another job's output comes after it (carcass > butcher > venison > cook / smoke / jerky). The planner is pull-based: the targets say what the household should hold, a shortage pulls the jobs that fill it and, back along the chain, the jobs that feed those.",
 "stages": ["gather", "process", "preserve", "craft", "upkeep"],
 "stage_names": {"gather": "Gather", "process": "Process", "preserve": "Preserve", "craft": "Craft", "upkeep": "Upkeep"},
 "groups": {
  "raw_food": ["brook_trout", "salmon", "sucker", "perch", "pike", "eel", "bullhead", "sturgeon", "pickerel", "venison", "small_game", "cornmeal", "corn", "squash", "beans"],
  "seed": ["seed_corn", "seed_beans", "seed_squash", "seed_tobacco", "seed_flax"],
  "green_pelt": {"from": "materials", "suffix": "_pelt", "twin_prefix": "dried_"}
 },
 "targets": {
  "meals": {"name": "Cooked food", "per_person": 3, "kinds": ["johnnycake", "roast_venison", "charred_venison", "roast_small_game", "charred_small_game", "roast_fish", "charred_fish", "roast_corn", "charred_corn", "roast_squash", "charred_squash", "bean_pot", "scorched_beans"]},
  "pantry": {"name": "Berries and nuts", "per_person": 4, "kinds": ["blackberries", "strawberries", "elderberries", "crabapples", "hazelnuts", "acorns"]},
  "firewood": {"name": "Firewood", "min": 8, "kinds": ["firewood"]},
  "jerky": {"name": "Jerky put by", "min": 12, "kinds": ["jerky"]},
  "leather": {"name": "Leather", "min": 4, "kinds": ["buckskin", "rawhide"]},
  "furs": {"name": "Dried furs", "min": 2, "kinds": ["dried_wolf_pelt", "dried_fox_pelt", "dried_marten_pelt", "dried_mink_pelt", "dried_fisher_pelt", "dried_raccoon_pelt"]},
  "tobacco": {"name": "Tobacco leaves", "min": 6, "kinds": ["tobacco_leaves"]},
  "flax": {"name": "Flax", "min": 6, "kinds": ["flax"]}
 },
 "chain_names": {"teach": "Family: teaching the children", "butcher": "Game: carcass to table", "hunt": "Game: the hunt to the table", "firewood": "Wood: from the woods to the fires", "forage": "Foraging", "hoe": "Farm: the beds to the table"},
