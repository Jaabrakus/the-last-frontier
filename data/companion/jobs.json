    {"id": "rawhide", "inputs": {"deer_hide": 1}, "min_have": {"deer_hide": 2}, "params": {"recipe": "rcp.rawhide"}, "text": "Fleshing and scraping the hide", "done": "scrapes the hide:", "outputs": {"rawhide": 2}}
