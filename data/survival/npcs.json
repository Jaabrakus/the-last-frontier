  "block": "[start 'HH:MM', location ('home' | 'work' | 'spot:<tag>' | poi id), activity tag]",
  "inherit": "a key may say {'inherit': 'default', 'outdoor_to': 'work'} to reuse another key with changes",
  "no_weekdays": "A game day stands for about ten, so recurring social time uses calendar events instead of weekdays.",
  "src": [
   "Y:9.1",
   "Y:2.5"
  ]
 },
