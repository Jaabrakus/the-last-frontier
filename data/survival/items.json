{
 "schema": "frontier.survival.items",
 "version": 4,
 "status": "LIVE design data v4: the vertical slice (milestones M1, M2a and M2b; survival_gdd.md version 4). The game and tests/survival/test_survival_data.gd read these rows. Every number is tunable.",
 "design_doc": "Player_Animation_Project/graph_analysis/survival/survival_gdd.md",
 "summary": "Items in the slice, each in its period trade unit, with weight, food energy in game kcal (the historical value divided by the flow factor), food group, spoilage class, clothing class and durability. Food shows to the player in meals only.",
 "id_rules": "Ids are stable strings (prefix.name). Never rename an id once saves exist; add an alias instead. Display names are separate and may change. An id is defined in exactly one place: the live file or the backlog.",
 "milestones": {
  "M1": "A winter night: fire, shelter, cold, hunger, sleep, time safety; the fort region only; one background; 1765",
  "M2a": "A winter from the woods: living from the manor woods through the winter by your own hands (gathering, hides, sewing, snares, snowshoes, a half-faced camp, a hung cache, ice fishing); plain barter with the sutler, the trader, the garrison's soldiers, a farm family from German Flatts and an old hunter; credit and the fall outfit as options; the second background",
  "M2b": "Learning from neighbours: lessons, watching, examining, quality standards, haggling, promises and loans",
  "M3": "The year turns: the full almanac, seasons and weather content, the summer goal (bark and a cabin), fishing, frogs, ginseng, one played wage job; the fur cap and robe, leggings, carving, casting balls, the cache pit, char cloth and spruce beer",
  "M4": "People: NPC schedules and tiers at the fort, standing, invitations, the soldiers and the lieutenant as mentors; Native characters only after the relevant nation's sign-off",
  "M5": "The map: the Carry, the valley, the town and the hunting grounds, travel and camps, other markets and backgrounds",
  "post": "After M5 and not yet planned: the 1757 and 1761 starts and their eras, detailed illnesses, thirst, potash, upstream canoe and bateau travel, the Proxy NPC tier, languages beyond English, French, Mohawk and Oneida"
 },
 "source_keys": {
  "E": "graph_analysis/survival/research_economy_life.md, source list S# (E:S14 = source S14)",
  "K": "graph_analysis/survival/research_survival_skills.md, numbered sources [#] (K:1 = source [1])",
  "Y": "graph_analysis/survival/research_systems.md, section number (Y:3.2 = section 3.2)",
  "C": "graph_analysis/customizer/costume_bible.md, section number",
  "A": "Player_Animation_Project/blender_animation_index.csv (clip names and asset ids)",
  "N": "graph_analysis/survival/survival_gdd.md, sources list (N:3 = source N3; N33 onward added in version 3)"
 },
 "basis_keys": {
  "S": "sourced: checked against a primary source, a scholarly work or an institutional page; web summaries and popular pages do not qualify",
  "H": "standard historiography (books in the GDD sources list); verify before quoting",
  "H-regional": "true for one region's trade or society (named in the row); not yet checked for New York",
  "M": "modern science or medicine sets the mechanic (period explanation may differ)",
  "D": "design value for balance, or a figure resting on web summaries; not a checked historical record"
 },
 "food_energy_note": "kcal_hist is the historical food energy per unit; kcal is game kcal = kcal_hist / 5 (seasons.json time.flow_factor). The body eats game kcal.",
