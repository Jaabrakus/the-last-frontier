 "durability_rule": {
  "walk": "footwear and snowshoes lose 1 / durability_walk_h of a pair each game hour of walking (walk, run, snowshoe, wading) while worn; standing work (heavy work), work at the waist or stooped low (a hide on its frame, foraging, chinking) and kneeling work (setting traps, skinning, digging) wear them at half that rate [D; fix round 1]",
  "worn": "mitts and caps lose 1 / (durability_game_days x 24) each game hour worn outdoors",
  "wear_out": "a worn-out pair is gone; a spare of the same item is put on at once",
  "mend": "clothing.repair_moccasins adds 0.6 of a new pair's durability (0.7 excellent, 0.3 partial) to the worn item",
  "basis": "D; Doddridge's hunters mended moccasins at night (W:3)"
 },
 "curing_rule": "Items made with a recipe's cure_game_days wait out the cure (meta.curing) before they can be worn, eaten, used as an input or traded: buckskin is smoked a game day, jerky dries on the rack 1-2 game days (recipes.json rules).",
 "tradeable_rule": "Everything is tradeable unless the row says tradeable: false. People, scalps and wampum are never items (GDD section 13)."
