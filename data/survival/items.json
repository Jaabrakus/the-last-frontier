 "clothing_rules": {
  "zones": [
   "head",
   "torso",
   "hands",
   "legs",
   "feet"
  ],
  "customizer_link": "Each customizer garment id maps to one class above; the worn outfit therefore sets insulation. Unlisted garments (accessories, jewellery) add nothing.",
  "wet_rule": "effective ins = ins * (1 - wetness * (1 - wet_keep))",
  "sources": [
   "K:9.2",
   "C:2-5"
  ]
 },
 "pelt_rules": {
  "grade_by_handling": {
   "poor": 0.5,
   "fair": 0.8,
   "good": 1.0,
   "prime_well_handled": 1.15,
   "source": "K:7.2 handling grades"
  },
  "skin_outcome_to_grade": {
   "excellent": "prime_well_handled",
   "success": "good",
   "partial": "fair",
   "failure": "poor"
  },
  "stretch_outcome_shift": {
   "excellent": 1,
   "success": 1,
   "partial": 0,
   "failure": -1
  },
  "prime_factor": "seasons.json pelt_prime_by_species[species][month] at the moment of the kill. Fur pelts only: deerskins and elk hides use their fall and summer items instead (items skin.deer_fall and skin.deer_summer) and take no prime factor (review 2, issue 17).",
  "prime_applies_to_cats": [
   "pelt"
  ],
  "animal_condition": {
   "1": 0.8,
   "2": 0.9,
   "3": 1.0,
   "note": "animals carry a 1-3 condition (Y:2.4)"
  },
  "weapon_fit": {
   "right_size": 1.0,
   "too_big_for_small_game": 0.6,
   "too_small_for_large_game": 0.8,
   "trap_or_snare": 1.0,
   "arrow_on_small_or_medium": 1.0,
   "note": "The bow is silent and suits small and medium game; the musket suits large game (Y:3.8)."
  },
  "shot_quality": {
   "clean_vital": 1.0,
   "body": 0.85,
   "gut_or_multiple": 0.7
  },
  "value_formula": "price = market value (economy.json price layers) * prime_factor (pelts only) * animal_condition * weapon_fit * shot_quality * grade_by_handling * market terms",
  "slipped": {
   "after": "green_pelt spoilage (a thaw)",
   "grade": "poor",
   "extra_mult": 0.3
  }
 },
