class_name WaterNetwork
extends RefCounted
## A region's water as a network (data/world/maps/<region>/water.json, generated by
## tools/environment/water/build_water_json.py from the region's layout.json; tools/environment/water/water_net.py is its
## numpy twin, the same maths): channels (centre lines with a level, half width, bed and speed along them), the junction
## where one joins another, pounds (flat water in a polygon: a lock chamber, a basin, paddy steps), reaches whose flow
## world state scales (the Silent Reach), and the lock step. Channel-local: WorldRiver has one x for each z, which a
## west-east torrent breaks, so here a point asks which channel it is in and where along it.
##   channel_at(pos)         {channel, s (m along), offset (+ on the right bank looking downstream), half_width}, or {}
##   surface_at(x, z)        the water's surface there, NO_WATER where there is none
##   depth_at(x, z, ground)  how deep it is over ground.call(x, z) (0 where none)
##   current_at(x, z)        m/s, flat: along its channel at the channel's speed there x the reach's flow; none on a pound
##   flow_scale_at(x, z)     1 running as ever, 0 still: a reach's scale inside it, eased back to 1 over ease_m past its
##                           ends (as WorldRiver.rapid_at's ramp); 0 on a pound or off the water
##   is_under_water(p)
##   set_state(state)        every reach's scale from its scale_by_state (S0..S4); set_reach_flow(reach_id, scale) by hand
##   set_milestone(m)        what is built: M0, M1 (the default), M2 (the lock step holds its upper level down to the
##                           lower gate, and the M2 pounds are water); later things are left out
##   set_day(day)            pounds with a curve sit at pound_level_at(pound, day): bible days since the river stopped
##   as_world_river_block(channel_id)  a z-monotonic channel as WorldRiver's nodes (Phase 3 M0); {} for the torrent
## Where they overlap a pound wins, then the channels in rank order (the joined one first); over a joining channel's
## mouth (mouth_m outside the joined one's water) its level eases onto the joined one's, so the two meet without a step.
## Not wired in: Phase 3 M1 ports WorldRiver's callers to it.

const NO_WATER := -INF
const R1_PATH := "res://data/world/maps/r1/water.json"
const BUCKET_M := 32.0

var data := {}
var milestones: Array = ["M0", "M1", "M2"]
var milestone := 1
var day := 0.0
var _channels: Array[Dictionary] = []
var _by_id := {}
var _pounds: Array = []
var _pound_by_id := {}
var _curves := {}
var _reach_scale := {}


static func from_file(path: String = R1_PATH) -> WaterNetwork:
	var f := FileAccess.open(path, FileAccess.READ)
	var d: Variant = JSON.parse_string(f.get_as_text()) if f else null
	return from_data(d if d is Dictionary else {})


static func from_data(d: Dictionary) -> WaterNetwork:
	var net := WaterNetwork.new()
	net._load(d)
	return net


func _load(d: Dictionary) -> void:
	data = d
	milestones = d.get("milestones", milestones)
	var mouth := 0.0
	for j: Dictionary in d.get("junctions", []):
		mouth = maxf(mouth, float(j.get("mouth_m", 0.0)))
	for c: Dictionary in d.get("channels", []):
		# node_fields: s, x, z, half_width, level, bed_depth, speed
		var ss := PackedFloat64Array()
		var xs := PackedFloat64Array()
		var zs := PackedFloat64Array()
		var hws := PackedFloat64Array()
		var lvs := PackedFloat64Array()
		var beds := PackedFloat64Array()
		var speeds := PackedFloat64Array()
		var max_hw := 0.0
		for row: Array in c.get("nodes", []):
			ss.append(float(row[0]))
			xs.append(float(row[1]))
			zs.append(float(row[2]))
			hws.append(float(row[3]))
			lvs.append(float(row[4]))
			beds.append(float(row[5]))
			speeds.append(float(row[6]))
			max_hw = maxf(max_hw, float(row[3]))
		var ch := {
			"id": String(c.id), "rank": int(c.get("rank", 0)), "milestone": String(c.get("milestone", "M0")),
			"z_monotonic": bool(c.get("z_monotonic", false)), "exponent": float(c.get("bed", {}).get("exponent", 2.0)),
			"reaches": c.get("reaches", []), "steps": c.get("steps", []), "join": "", "mouth_m": 0.0,
			"s": ss, "x": xs, "z": zs, "hw": hws, "level": lvs, "bed": beds, "speed": speeds,
		}
		# which segments can be nearest anywhere in a BUCKET_M cell: those within their reach (widest half width
		# plus a mouth) of it
		var r := max_hw + mouth + 2.0
		var buckets := {}
		for i in xs.size() - 1:
			for cx in range(floori((minf(xs[i], xs[i + 1]) - r) / BUCKET_M), floori((maxf(xs[i], xs[i + 1]) + r) / BUCKET_M) + 1):
				for cz in range(floori((minf(zs[i], zs[i + 1]) - r) / BUCKET_M), floori((maxf(zs[i], zs[i + 1]) + r) / BUCKET_M) + 1):
					var key := Vector2i(cx, cz)
					if not buckets.has(key):
						buckets[key] = []
					(buckets[key] as Array).append(i)
		ch["buckets"] = buckets
		_channels.append(ch)
		_by_id[ch.id] = ch
	_channels.sort_custom(func(a: Dictionary, b: Dictionary) -> bool: return int(a.rank) < int(b.rank))
	for j: Dictionary in d.get("junctions", []):
		if _by_id.has(j.channel):
			var jc: Dictionary = _by_id[j.channel]
			jc["join"] = String(j.into)
			jc["mouth_m"] = float(j.mouth_m)
	_pounds = d.get("pounds", [])
	for p: Dictionary in _pounds:
		_pound_by_id[String(p.id)] = p
	_curves = d.get("curves", {})
	set_state("S0")


# --- world state ----------------------------------------------------------------------------------------------------

func set_milestone(m: String) -> void:
	milestone = milestones.find(m)


func _live(m: String) -> bool:
	return milestones.find(m) <= milestone


func set_state(state: String) -> void:
	for ch: Dictionary in _channels:
		for r: Dictionary in ch.reaches:
			_reach_scale[String(r.id)] = float(r.get("scale_by_state", {}).get(state, 1.0))


func set_reach_flow(reach_id: String, scale: float) -> void:
	_reach_scale[reach_id] = scale


func reach_flow(reach_id: String) -> float:
	return float(_reach_scale.get(reach_id, 1.0))


func set_day(d: float) -> void:
	day = d


## A pound's level on `d` bible days since the river stopped (S1's first day): its curve's, or flat without one.
func pound_level_at(pound_id: String, d: float) -> float:
	var p: Dictionary = _pound_by_id.get(pound_id, {})
	if p.is_empty():
		return NO_WATER
	var lv := float(p.level)
	var cv: Dictionary = _curves.get(String(p.get("curve", "")), {})
	if cv.is_empty():
		return lv
	return lv + _interp(cv.nodes, maxf(d, 0.0))


static func _interp(nodes: Array, u: float) -> float:
	var a: Array = nodes[0]
	if u <= float(a[0]):
		return float(a[1])
	for k in range(1, nodes.size()):
		var b: Array = nodes[k]
		if u <= float(b[0]):
			return float(a[1]) + (float(b[1]) - float(a[1])) * (u - float(a[0])) / (float(b[0]) - float(a[0]))
		a = b
	return float(a[1])


static func _ease01(u: float) -> float:
	u = clampf(u, 0.0, 1.0)
	return u * u * (3.0 - 2.0 * u)


# --- along a channel ------------------------------------------------------------------------------------------------

## The nearest centre-line point to (x, z): {seg, t, offset, s, half_width}; {} when no segment is within the channel's
## reach or the point lies past either end.
func _locate(ch: Dictionary, x: float, z: float) -> Dictionary:
	var segs: Array = ch.buckets.get(Vector2i(floori(x / BUCKET_M), floori(z / BUCKET_M)), [])
	if segs.is_empty():
		return {}
	var xs: PackedFloat64Array = ch.x
	var zs: PackedFloat64Array = ch.z
	var best := INF
	var bi := -1
	var bt := 0.0
	var braw := 0.0
	var bside := 0.0
	for i: int in segs:
		var ax := xs[i]
		var az := zs[i]
		var dx := xs[i + 1] - ax
		var dz := zs[i + 1] - az
		var l2 := dx * dx + dz * dz
		var raw := ((x - ax) * dx + (z - az) * dz) / l2
		var t := clampf(raw, 0.0, 1.0)
		var qx := ax + t * dx
		var qz := az + t * dz
		var d2 := (x - qx) * (x - qx) + (z - qz) * (z - qz)
		if d2 < best:
			var l := sqrt(l2)
			best = d2
			bi = i
			bt = t
			braw = raw
			bside = (x - qx) * (-dz / l) + (z - qz) * (dx / l)
	if (bi == 0 and braw < 0.0) or (bi == xs.size() - 2 and braw > 1.0):
		return {}
	var ss: PackedFloat64Array = ch.s
	var hws: PackedFloat64Array = ch.hw
	var dist := sqrt(best)
	return {"seg": bi, "t": bt, "offset": dist if bside >= 0.0 else -dist,
			"s": ss[bi] + bt * (ss[bi + 1] - ss[bi]), "half_width": hws[bi] + bt * (hws[bi + 1] - hws[bi])}


static func _field(arr: PackedFloat64Array, seg: int, t: float) -> float:
	return arr[seg] + t * (arr[seg + 1] - arr[seg])


func _level(ch: Dictionary, seg: int, t: float, s: float) -> float:
	var lv := _field(ch.level, seg, t)
	for st: Dictionary in ch.steps:
		if _live(String(st.get("milestone", "M2"))) and s >= float(st.s_upper) and s < float(st.s_lower):
			lv = float(st.level_upper)
	return lv


func _flow_factor(ch: Dictionary, s: float) -> float:
	var f := 1.0
	for r: Dictionary in ch.reaches:
		var d := maxf(maxf(float(r.s_from) - s, s - float(r.s_to)), 0.0)
		var w := 1.0 - _ease01(d / maxf(float(r.ease_m), 1e-6))
		f *= 1.0 + (reach_flow(String(r.id)) - 1.0) * w
	return f


## [segment, t] of the point `s` m along.
func _seg_at_s(ch: Dictionary, s: float) -> Array:
	var ss: PackedFloat64Array = ch.s
	var i := clampi(ss.bsearch(s, false) - 1, 0, ss.size() - 2)
	return [i, clampf((s - ss[i]) / (ss[i + 1] - ss[i]), 0.0, 1.0)]


func channel_ids() -> PackedStringArray:
	var out := PackedStringArray()
	for ch: Dictionary in _channels:
		out.append(String(ch.id))
	return out


func length(channel_id: String) -> float:
	var ss: PackedFloat64Array = _by_id[channel_id].s
	return ss[ss.size() - 1]


## The surface on the centre line `s` m along (the lock step held from M2).
func level_at_s(channel_id: String, s: float) -> float:
	var ch: Dictionary = _by_id[channel_id]
	var it := _seg_at_s(ch, s)
	return _level(ch, it[0], it[1], s)


## The centre line's point `s` m along, at its surface.
func point_at(channel_id: String, s: float) -> Vector3:
	var ch: Dictionary = _by_id[channel_id]
	var it := _seg_at_s(ch, s)
	return Vector3(_field(ch.x, it[0], it[1]), _level(ch, it[0], it[1], s), _field(ch.z, it[0], it[1]))


## Downstream along the centre line `s` m along (flat, unit).
func tangent_at(channel_id: String, s: float) -> Vector3:
	var ch: Dictionary = _by_id[channel_id]
	var i: int = _seg_at_s(ch, s)[0]
	var xs: PackedFloat64Array = ch.x
	var zs: PackedFloat64Array = ch.z
	return Vector3(xs[i + 1] - xs[i], 0.0, zs[i + 1] - zs[i]).normalized()


func half_width_at(channel_id: String, s: float) -> float:
	var ch: Dictionary = _by_id[channel_id]
	var it := _seg_at_s(ch, s)
	return _field(ch.hw, it[0], it[1])


# --- queries --------------------------------------------------------------------------------------------------------

static func _in_polygon(poly: Array, x: float, z: float) -> bool:
	var inside := false
	var n := poly.size()
	for k in n:
		var a: Array = poly[k]
		var b: Array = poly[(k + 1) % n]
		var az := float(a[1])
		var bz := float(b[1])
		if (az > z) != (bz > z) and x < float(a[0]) + (z - az) * (float(b[0]) - float(a[0])) / (bz - az):
			inside = not inside
	return inside


## What is at (x, z): {surface, pound} or {surface, channel, loc}, or {surface: NO_WATER}.
func _resolve(x: float, z: float) -> Dictionary:
	for p: Dictionary in _pounds:
		if _live(String(p.get("milestone", "M1"))) and _in_polygon(p.polygon, x, z):
			return {"surface": pound_level_at(String(p.id), day), "pound": p}
	for ch: Dictionary in _channels:
		if not _live(ch.milestone):
			continue
		var loc := _locate(ch, x, z)
		if loc.is_empty() or absf(loc.offset) > float(loc.half_width):
			continue
		var lv := _level(ch, loc.seg, loc.t, loc.s)
		if ch.join != "" and _live(_by_id[ch.join].milestone):
			var into: Dictionary = _by_id[ch.join]
			var li := _locate(into, x, z)
			if not li.is_empty():
				var w := 1.0 - _ease01((absf(li.offset) - float(li.half_width)) / float(ch.mouth_m))
				lv += (_level(into, li.seg, li.t, li.s) - lv) * w
		return {"surface": lv, "channel": ch, "loc": loc}
	return {"surface": NO_WATER}


func channel_at(pos: Vector3) -> Dictionary:
	for ch: Dictionary in _channels:
		if not _live(ch.milestone):
			continue
		var loc := _locate(ch, pos.x, pos.z)
		if not loc.is_empty() and absf(loc.offset) <= float(loc.half_width):
			return {"channel": String(ch.id), "s": loc.s, "offset": loc.offset, "half_width": loc.half_width}
	return {}


func surface_at(x: float, z: float) -> float:
	return float(_resolve(x, z).surface)


func depth_at(x: float, z: float, ground: Callable) -> float:
	var s := surface_at(x, z)
	return maxf(s - float(ground.call(x, z)), 0.0) if s != NO_WATER else 0.0


func is_under_water(p: Vector3) -> bool:
	return p.y < surface_at(p.x, p.z)


func flow_scale_at(x: float, z: float) -> float:
	var r := _resolve(x, z)
	if not r.has("channel"):
		return 0.0
	return _flow_factor(r.channel, r.loc.s)


func current_at(x: float, z: float) -> Vector3:
	var r := _resolve(x, z)
	if not r.has("channel"):
		return Vector3.ZERO
	var ch: Dictionary = r.channel
	var seg: int = r.loc.seg
	var xs: PackedFloat64Array = ch.x
	var zs: PackedFloat64Array = ch.z
	var v := _field(ch.speed, seg, r.loc.t) * _flow_factor(ch, r.loc.s)
	return Vector3(xs[seg + 1] - xs[seg], 0.0, zs[seg + 1] - zs[seg]).normalized() * v


# --- for WorldRiver (Phase 3 M0) ------------------------------------------------------------------------------------

## A z-monotonic channel as WorldRiver's node extension reads it: nodes [z, x, level, half_width] (linear between
## them), the widest half width as its bank, its reaches by z, no rapids. {} for a channel that is not z-monotonic.
func as_world_river_block(channel_id: String) -> Dictionary:
	var ch: Dictionary = _by_id.get(channel_id, {})
	if ch.is_empty() or not ch.z_monotonic:
		return {}
	var nodes: Array = []
	var bank := 0.0
	var zs: PackedFloat64Array = ch.z
	var xs: PackedFloat64Array = ch.x
	var lv: PackedFloat64Array = ch.level
	var hws: PackedFloat64Array = ch.hw
	for i in zs.size():
		nodes.append([zs[i], xs[i], lv[i], hws[i]])
		bank = maxf(bank, hws[i])
	var reaches: Array = []
	for r: Dictionary in ch.reaches:
		reaches.append({"id": r.id, "z_from": float(r.z_from), "z_to": float(r.z_to), "ease_m": float(r.ease_m),
				"scale_by_state": (r.scale_by_state as Dictionary).duplicate()})
	return {"channel": channel_id, "nodes": nodes, "node_fields": ["z", "x", "level", "half_width"], "bank": bank,
			"reaches": reaches, "rapids": []}
