extends RefCounted
## Meshes, materials and metadata of package C's vegetation assets (loaded once, cached).
## No class_name: vegetation.gd preloads this file, so it never depends on the global class
## cache (a concurrent run before `--import` cannot hit a parse error through it).
##
## Sources (see assets/environment/vegetation/SOURCES.md and assets/environment/props/SOURCES.md):
##   trees/<species>.glb       generated by tools/environment/vegetation/build_trees.py
##                             (objects <species>_v<k>_lod<n>), trees/trees.json = metadata
##   foliage/foliage_*.png     card atlas (build_atlas.py + assemble_atlas.py)
##   impostors/impostor_*.png  8-view impostor atlas (bake_impostors.gd + assemble_impostors.py)
##   bark/*.png                bark_brown_02 graded (conifer / hardwood), procedural birch
##   ../props/<id>/<id>.glb    decimated Poly Haven props (process_props.py), props.json

const VEG_DIR := "res://assets/environment/vegetation/"
## The distant trees' painted look (painted_look.gd): painted_tree_material, painted_impostor_material.
const PaintedLook := preload("res://scripts/world/vegetation/painted_look.gd")
const PROPS_DIR := "res://assets/environment/props/"

## Species (index = kind id used by the layout). height_scale is applied on top of the mesh.
const SPECIES := [
	"white_pine", "hemlock", "oak", "maple", "birch",
	"sapling_pine", "sapling_hemlock", "sapling_maple", "sapling_birch", "shrub_hazel",
]
const WHITE_PINE := 0
const HEMLOCK := 1
const OAK := 2
const MAPLE := 3
const BIRCH := 4
const SAPLING_PINE := 5
const SAPLING_HEMLOCK := 6
const SAPLING_MAPLE := 7
const SAPLING_BIRCH := 8
const SHRUB_HAZEL := 9
const CANOPY_COUNT := 5

## Props (index = prop kind id). asset = folder / glb under props/, lods = number of LODs.
const PROPS := [
	{"name": "stump_a", "asset": "tree_stump_01", "lods": 3},
	{"name": "stump_b", "asset": "tree_stump_02", "lods": 3},
	{"name": "rock_a", "asset": "rock_moss_set_01", "lods": 3},
	{"name": "rock_b", "asset": "rock_moss_set_01", "lods": 3},
	{"name": "rock_c", "asset": "rock_moss_set_01", "lods": 3},
	{"name": "rock_d", "asset": "rock_moss_set_02", "lods": 3},
	{"name": "rock_e", "asset": "rock_moss_set_02", "lods": 3},
	{"name": "boulder", "asset": "boulder_01", "lods": 3},
	{"name": "log", "asset": "dead_tree_trunk", "lods": 3},
	{"name": "roots", "asset": "root_cluster_01", "lods": 3},
	{"name": "brush", "asset": "dry_branches_medium_01", "lods": 3},
	{"name": "fern_a", "asset": "fern_02", "lods": 2},
	{"name": "fern_b", "asset": "fern_02", "lods": 2},
	{"name": "fern_c", "asset": "fern_02", "lods": 2},
	{"name": "fern_d", "asset": "fern_02", "lods": 2},
]
const STUMP_A := 0
const STUMP_B := 1
const ROCK_FIRST := 2
const ROCK_LAST := 7            ## boulder included
const LOG := 8
const ROOTS := 9
const BRUSH := 10
const FERN_FIRST := 11
const FERN_LAST := 14

## Material look per species: bark set, tints (multiplied on the atlas / bark colour).
const LOOK := {
	"white_pine": {"bark": "conifer", "bark_tint": Color(0.95, 0.93, 0.93), "leaf_tint": Color(1.05, 1.0, 0.86),
			"variation": Color(0.9, 0.97, 0.96), "dry": Color(1.1, 1.05, 0.8)},
	"hemlock": {"bark": "conifer", "bark_tint": Color(1.02, 0.94, 0.9), "leaf_tint": Color(0.95, 1.0, 0.95),
			"variation": Color(0.88, 0.95, 0.9), "dry": Color(1.1, 1.05, 0.8)},
	"oak": {"bark": "hardwood", "bark_tint": Color(1.0, 1.0, 1.0), "leaf_tint": Color(0.92, 0.96, 0.86),
			"variation": Color(1.08, 1.02, 0.82), "dry": Color(1.25, 1.05, 0.62)},
	"maple": {"bark": "hardwood", "bark_tint": Color(1.08, 1.06, 1.04), "leaf_tint": Color(0.94, 0.98, 0.9),
			"variation": Color(0.92, 1.02, 0.9), "dry": Color(1.35, 1.0, 0.6)},
	"birch": {"bark": "birch", "bark_tint": Color(0.95, 0.95, 0.95), "leaf_tint": Color(0.96, 0.98, 0.9),
			"variation": Color(1.08, 1.05, 0.8), "dry": Color(1.25, 1.1, 0.6)},
	"shrub_hazel": {"bark": "hardwood", "bark_tint": Color(0.85, 0.8, 0.75), "leaf_tint": Color(0.94, 0.98, 0.9),
			"variation": Color(1.05, 1.05, 0.85), "dry": Color(1.2, 1.05, 0.65)},
}

static var _tree_info := {}
static var _props_info := {}
static var _scenes := {}
static var _meshes := {}
static var _materials := {}
static var _textures := {}
static var _impostor_info := {}


# --- Metadata ---------------------------------------------------------------------------------

## trees.json keyed by "<species>_v<k>": height, crown_center, crown_radius, crown_bottom,
## crown_top, trunk_radius, collider_height, lod_tris ...
static func tree_info() -> Dictionary:
	if _tree_info.is_empty():
		_tree_info = _read_json_list(VEG_DIR + "trees/trees.json", "name")
	return _tree_info


static func tree(kind: int, variant: int) -> Dictionary:
	return tree_info().get("%s_v%d" % [SPECIES[kind], variant], {})


## props.json keyed by variant name: asset, kind, size [x, y, z] (Y up), tris, hull.
static func props_info() -> Dictionary:
	if _props_info.is_empty():
		var f := FileAccess.open(PROPS_DIR + "props.json", FileAccess.READ)
		if f:
			var d: Variant = JSON.parse_string(f.get_as_text())
			if d is Dictionary:
				_props_info = d
	return _props_info


static func prop(kind: int) -> Dictionary:
	return props_info().get(PROPS[kind].name, {})


## impostors.json: rows [{name, frame_w, frame_h, frame_y0}], frames, row_count.
static func impostor_info() -> Dictionary:
	if _impostor_info.is_empty():
		var f := FileAccess.open(VEG_DIR + "impostors/impostors.json", FileAccess.READ)
		if f:
			var d: Variant = JSON.parse_string(f.get_as_text())
			if d is Dictionary:
				_impostor_info = d
	return _impostor_info


static func impostor_row(kind: int, variant: int) -> int:
	var rows: Array = impostor_info().get("rows", [])
	var want := "%s_v%d" % [SPECIES[kind], variant]
	var fallback := -1
	for i in rows.size():
		var n: String = rows[i].name
		if n == want:
			return i
		if fallback < 0 and n.begins_with(SPECIES[kind] + "_v"):
			fallback = i
	return fallback


static func _read_json_list(path: String, key: String) -> Dictionary:
	var out := {}
	var f := FileAccess.open(path, FileAccess.READ)
	if f == null:
		push_warning("VegAssets: missing %s" % path)
		return out
	var d: Variant = JSON.parse_string(f.get_as_text())
	if d is Array:
		for r: Variant in d:
			if r is Dictionary and (r as Dictionary).has(key):
				out[r[key]] = r
	return out


# --- Meshes -------------------------------------------------------------------------------------

static func tree_mesh(kind: int, variant: int, lod: int) -> Mesh:
	var sp: String = SPECIES[kind]
	return _mesh_from(VEG_DIR + "trees/%s.glb" % sp, "%s_v%d_lod%d" % [sp, variant, lod])


static func prop_mesh(kind: int, lod: int) -> Mesh:
	var p: Dictionary = PROPS[kind]
	return _mesh_from(PROPS_DIR + "%s/%s.glb" % [p.asset, p.asset], "%s_lod%d" % [p.name, lod])


static func _mesh_from(scene_path: String, node_name: String) -> Mesh:
	var key := scene_path + ":" + node_name
	if _meshes.has(key):
		return _meshes[key]
	if not _scenes.has(scene_path):
		var ps := load(scene_path) as PackedScene
		var meshes := {}
		if ps:
			var root := ps.instantiate()
			for n in root.find_children("*", "MeshInstance3D", true, false):
				meshes[String(n.name)] = (n as MeshInstance3D).mesh
			root.free()
		else:
			push_warning("VegAssets: cannot load %s" % scene_path)
		_scenes[scene_path] = meshes
	var m: Mesh = _scenes[scene_path].get(node_name)
	if m == null:
		push_warning("VegAssets: no mesh %s in %s" % [node_name, scene_path])
	_meshes[key] = m
	return m


## The impostor template for the MultiMesh: the unit frame (x -0.5..0.5, y 0..1, facing +Z),
## trimmed to the octagon in impostors.json ("cutout", the union of every baked view) so less
## empty frame is rasterised; the vertex shader places it from UV. Its AABB is inflated so
## culling covers the real billboard (up to 24 m wide, 32 m tall at scale 1).
static func impostor_quad() -> Mesh:
	if _meshes.has("impostor_quad"):
		return _meshes["impostor_quad"]
	var cut: Array = impostor_info().get("cutout", [[0, 0], [1, 0], [1, 1], [0, 1]])
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for i in range(1, cut.size() - 1):
		for j: int in [0, i, i + 1]:
			var c: Array = cut[j]
			st.set_normal(Vector3(0, 0, 1))
			st.set_uv(Vector2(float(c[0]), 1.0 - float(c[1])))
			st.add_vertex(Vector3(float(c[0]) - 0.5, float(c[1]), 0.0))
	var m := st.commit()
	m.custom_aabb = AABB(Vector3(-13, -2, -13), Vector3(26, 34, 26))
	_meshes["impostor_quad"] = m
	return m


# --- Materials ----------------------------------------------------------------------------------

static func tex(path: String) -> Texture2D:
	if not _textures.has(path):
		_textures[path] = load(path) as Texture2D if ResourceLoader.exists(path) else null
		if _textures[path] == null:
			push_warning("VegAssets: missing texture %s" % path)
	return _textures[path]


## ShaderMaterial (shaders/vegetation/tree.gdshader) for a species; saplings share their
## parent species' look. Saplings and shrubs lean away from a rider as a whole (push_whole), so
## they have their own materials.
static func tree_material(kind: int) -> ShaderMaterial:
	var sp: String = SPECIES[kind]
	var look_key := sp
	match kind:
		SAPLING_PINE: look_key = "white_pine"
		SAPLING_HEMLOCK: look_key = "hemlock"
		SAPLING_MAPLE: look_key = "maple"
		SAPLING_BIRCH: look_key = "birch"
	var small := kind >= SAPLING_PINE
	var key := ("small:" if small else "tree:") + look_key
	if _materials.has(key):
		return _materials[key]
	var look: Dictionary = LOOK[look_key]
	var m := ShaderMaterial.new()
	m.shader = load("res://shaders/vegetation/tree.gdshader")
	_apply_tree_params(m, look)
	m.set_shader_parameter("push_whole", 1.0 if small else 0.0)
	_materials[key] = m
	return m


## The painted material of a tree species for its distant LOD (painted_tree.gdshader, painted_look.gd): the same
## meshes, the photo textures only as masks, the species' greens.
static func painted_tree_material(kind: int) -> ShaderMaterial:
	var look_key: String = SPECIES[kind]
	var key := "painted:" + look_key
	if not _materials.has(key):
		var m := ShaderMaterial.new()
		m.shader = load("res://shaders/vegetation/painted_tree.gdshader")
		_apply_tree_params(m, LOOK[look_key])
		PaintedLook.apply_palette(m, look_key)
		m.set_shader_parameter("push_whole", 0.0)
		_materials[key] = m
	return _materials[key]


## The impostors in the painted look (painted_impostor.gdshader): impostor_material()'s rows, and the atlas baked
## from the painted trees (bake_impostors.gd style=painted, assemble_impostors.py name=painted): already painted and
## toned, so the shader's own repainting of the realistic atlas is off. Without that atlas, the realistic one repainted.
static func painted_impostor_material() -> ShaderMaterial:
	if not _materials.has("painted_impostor"):
		var m := impostor_material().duplicate() as ShaderMaterial
		m.shader = load("res://shaders/vegetation/painted_impostor.gdshader")
		if ResourceLoader.exists(VEG_DIR + "impostors/painted_impostor_albedo.png"):
			m.set_shader_parameter("imp_albedo", tex(VEG_DIR + "impostors/painted_impostor_albedo.png"))
			m.set_shader_parameter("imp_normal", tex(VEG_DIR + "impostors/painted_impostor_nrm.png"))
			m.set_shader_parameter("paint_flatten", 0.0)
			m.set_shader_parameter("paint_saturation", 1.0)
			m.set_shader_parameter("tone_saturation", 1.0)
			m.set_shader_parameter("tone_tint", Color(1, 1, 1))
			m.set_shader_parameter("albedo_scale", 1.0)
		_materials["painted_impostor"] = m
	return _materials["painted_impostor"]


## The impostor capture material: same textures and tints, unshaded (tree_bake.gdshader).
static func tree_bake_material(kind: int, mode: int) -> ShaderMaterial:
	var m := ShaderMaterial.new()
	m.shader = load("res://shaders/vegetation/tree_bake.gdshader")
	var look_key: String = SPECIES[kind]
	_apply_tree_params(m, LOOK.get(look_key, LOOK["oak"]))
	m.set_shader_parameter("bake_mode", mode)
	m.set_shader_parameter("trunk_flex", 0.0)
	m.set_shader_parameter("branch_flex", 0.0)
	m.set_shader_parameter("leaf_flex", 0.0)
	m.set_shader_parameter("push_strength", 0.0)
	m.set_shader_parameter("alpha_mip_boost", 0.0)
	return m


## The painted impostor capture (painted_bake.gdshader; bake_impostors.gd style=painted): the painted look's albedo.
static func painted_bake_material(kind: int, mode: int) -> ShaderMaterial:
	var m := ShaderMaterial.new()
	m.shader = load("res://shaders/vegetation/painted_bake.gdshader")
	var look_key: String = SPECIES[kind]
	_apply_tree_params(m, LOOK.get(look_key, LOOK["oak"]))
	PaintedLook.apply_palette(m, look_key)
	m.set_shader_parameter("bake_mode", mode)
	return m


static func _apply_tree_params(m: ShaderMaterial, look: Dictionary) -> void:
	var bark: String = look.bark
	if bark == "birch":
		m.set_shader_parameter("bark_albedo", tex(VEG_DIR + "bark/birch_albedo_1k.png"))
		m.set_shader_parameter("bark_normal", tex(VEG_DIR + "bark/birch_normal_1k.png"))
		m.set_shader_parameter("bark_arm", tex(VEG_DIR + "bark/birch_arm_1k.png"))
		m.set_shader_parameter("bark_base_dark_height", 0.9)
	else:
		m.set_shader_parameter("bark_albedo", tex(VEG_DIR + "bark/bark_%s_albedo_2k.png" % bark))
		m.set_shader_parameter("bark_normal", tex(VEG_DIR + "bark/bark_normal_2k.png"))
		m.set_shader_parameter("bark_arm", tex(VEG_DIR + "bark/bark_arm_2k.png"))
	m.set_shader_parameter("leaf_albedo", tex(VEG_DIR + "foliage/foliage_albedo.png"))
	m.set_shader_parameter("leaf_normal", tex(VEG_DIR + "foliage/foliage_normal.png"))
	m.set_shader_parameter("bark_tint", look.bark_tint)
	m.set_shader_parameter("leaf_tint", look.leaf_tint)
	m.set_shader_parameter("leaf_variation", look.variation)
	m.set_shader_parameter("leaf_dry", look.dry)


## Opaque material of the LOD4 shadow blobs (only rendered into shadow maps).
static func shadow_blob_material() -> Material:
	if not _materials.has("shadow_blob"):
		var m := StandardMaterial3D.new()
		m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		m.albedo_color = Color(0.2, 0.25, 0.15)
		_materials["shadow_blob"] = m
	return _materials["shadow_blob"]


static func impostor_material() -> ShaderMaterial:
	if _materials.has("impostor"):
		return _materials["impostor"]
	var m := ShaderMaterial.new()
	m.shader = load("res://shaders/vegetation/impostor.gdshader")
	m.set_shader_parameter("imp_albedo", tex(VEG_DIR + "impostors/impostor_albedo.png"))
	m.set_shader_parameter("imp_normal", tex(VEG_DIR + "impostors/impostor_nrm.png"))
	var info := impostor_info()
	var rows: Array = info.get("rows", [])
	var arr := PackedVector4Array()
	arr.resize(16)
	for i in mini(rows.size(), 16):
		var r: Dictionary = rows[i]
		arr[i] = Vector4(float(r.frame_w), float(r.frame_h), float(r.frame_y0), 0.0)
	m.set_shader_parameter("rows", arr)
	m.set_shader_parameter("frames", float(info.get("frames", 8)))
	m.set_shader_parameter("row_count", float(maxi(rows.size(), 1)))
	_materials["impostor"] = m
	return m


## Props: rocks, stumps, logs, roots, brush use StandardMaterial3D with the ORM (arm) map;
## ferns use shaders/vegetation/plant.gdshader (alpha, wind).
static func prop_material(kind: int) -> Material:
	var p: Dictionary = PROPS[kind]
	var asset: String = p.asset
	if _materials.has("prop:" + asset):
		return _materials["prop:" + asset]
	var base := PROPS_DIR + "%s/%s_" % [asset, asset]
	var m: Material
	if asset == "fern_02":
		var sm := ShaderMaterial.new()
		sm.shader = load("res://shaders/vegetation/plant.gdshader")
		sm.set_shader_parameter("albedo_tex", tex(base + "albedo_1k.png"))
		sm.set_shader_parameter("normal_tex", tex(base + "normal_1k.png"))
		sm.set_shader_parameter("arm_tex", tex(base + "arm_1k.png"))
		sm.set_shader_parameter("tint", Color(0.92, 0.95, 0.85))
		m = sm
	else:
		var om := ORMMaterial3D.new()
		om.albedo_texture = tex(base + "albedo_1k.png")
		om.normal_enabled = true
		om.normal_texture = tex(base + "normal_1k.png")
		om.orm_texture = tex(base + "arm_1k.png")
		om.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
		# Grade toward the spec's albedo targets (stone 0.12-0.22, wood 0.15-0.25 linear).
		match asset:
			"rock_moss_set_01", "rock_moss_set_02", "boulder_01":
				om.albedo_color = Color(0.92, 0.92, 0.9)
			"tree_stump_01", "tree_stump_02", "dead_tree_trunk", "root_cluster_01":
				om.albedo_color = Color(0.9, 0.88, 0.86)
			"dry_branches_medium_01":
				om.albedo_color = Color(0.85, 0.83, 0.8)
		m = om
	_materials["prop:" + asset] = m
	return m
