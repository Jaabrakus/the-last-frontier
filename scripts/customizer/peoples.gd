class_name CharacterPeoples
extends RefCounted
## Peoples and face presets for the customizer and NPCs (assets/character/body/peoples.json,
## generated by tools/character/body/peoples.py).
##
## A people is a distribution: mean weights of the face features (the body's `face_*`
## blend shapes), a within-group spread, skin (melanin range along "Tone 1-12", undertone
## frequencies, haemoglobin), eye and hair colour frequencies, hair texture and period hair
## styles. Presets are example individuals (two women and two men per people; six per body type
## for the Vietnamese, Thai and Malay peoples, their two realistic showcase faces first). Stylized
## presets (`stylized_presets`, the creator's default Face style) are example individuals made for
## the painted look: four per body type for every people, six for the East and Southeast Asian
## peoples (their two showcase faces first); preset() and preset_look() find both kinds. A people
## of the game's wider cast (East, South and Southeast Asia) carries a `licence_note`.
##
##   var p := CharacterPeoples.data()
##   var look := CharacterPeoples.preset_look("haudenosaunee_f_a")
##   var npc := CharacterPeoples.random_look("west_african", 1.0, rng)
##   var mixed := CharacterPeoples.random_look("english", 0.0, rng, "lenape", 0.5)
##
## The game's own peoples (data/customizer/world_peoples.json; the owner 2026-10-03: "maybe we dont use those races and
## we make custom ones for our full metal alchemist and edge chronicles sky pirates treasure planet game", then "yea lets
## test it"; docs/peoples_world.md): the Downbelowers, the Driftborn, the Keelfolk and the Etched. A test: the creator
## lists them (listed_groups, listed_peoples) unless the user arg peoples=real asks for the real ones; NPCs keep the real
## ones (tool and test runs list the real ones unless asked with peoples=world). Every face of the real peoples is a face
## of every world people (WORLD_FACES of them, two from each region, a
## different pick per people): people(), presets(), stylized_presets() and random_look() take a world people's id like a
## real one's; its skin, eye and hair colours, hair styles and its mark in the skin (`trait`) are its own.

const PATH := "res://assets/character/body/peoples.json"
const WORLD_PATH := "res://data/customizer/world_peoples.json"
## Faces a world people offers per body type and list (the creator's Face row): two from each region of the real peoples.
const WORLD_FACES := 18
const WORLD_PER_GROUP := 2

static var _data := {}
static var _world := {}
static var _group_of := {}       ## real people id -> its group (the world peoples' faces are picked by region)


static func data() -> Dictionary:
	if _data.is_empty():
		var d = JSON.parse_string(FileAccess.get_file_as_string(PATH)) if FileAccess.file_exists(PATH) else null
		_data = d if d is Dictionary else {"features": [], "peoples": [], "presets": [], "groups": []}
	return _data


static func features() -> Array:
	return data().get("features", [])


static func feature_keys() -> PackedStringArray:
	var out := PackedStringArray()
	for f: Dictionary in features():
		out.append(String(f.key))
	return out


static func groups() -> Array:
	return data().get("groups", [])


static func peoples(group := "") -> Array:
	var out := []
	for p: Dictionary in data().get("peoples", []):
		if group.is_empty() or p.get("group", "") == group:
			out.append(p)
	return out


## A people by id: a real one, else one of the world's.
static func people(id: String) -> Dictionary:
	for p: Dictionary in data().get("peoples", []):
		if p.get("id", "") == id:
			return p
	for p: Dictionary in world().get("peoples", []):
		if p.get("id", "") == id:
			return p
	return {}


# --- the world's own peoples --------------------------------------------------------------------------------------

## world_peoples.json: {groups, default, eye_colors, peoples}, each people filled out to read like a real one (_derive).
static func world() -> Dictionary:
	if _world.is_empty():
		var d = JSON.parse_string(FileAccess.get_file_as_string(WORLD_PATH)) if FileAccess.file_exists(WORLD_PATH) else null
		_world = (d as Dictionary).duplicate(true) if d is Dictionary else {}
		var list := []
		for p: Dictionary in _world.get("peoples", []):
			list.append(_derive(p))
		_world["peoples"] = list
		if not _world.has("groups"):
			_world["groups"] = []
	return _world


static func is_world(id: String) -> bool:
	for p: Dictionary in world().get("peoples", []):
		if p.get("id", "") == id:
			return true
	return false


## The creator lists the world's peoples (the test) unless the user arg peoples=real asks for the real ones. Tool and
## test runs (-s) list the real ones unless they ask with peoples=world (the creator's tests were written for those).
static func world_listed() -> bool:
	var args := OS.get_cmdline_user_args()
	if "peoples=real" in args or (world().get("peoples", []) as Array).is_empty():
		return false
	var script_run := "-s" in OS.get_cmdline_args() or "--script" in OS.get_cmdline_args()
	return not script_run or "peoples=world" in args


## The people a look takes when its own is not among the listed ones (the creator's first people).
static func default_people() -> String:
	return String(world().get("default", "english")) if world_listed() else "english"


## The groups and peoples the creator shows: the world's (the test), else the real ones.
static func listed_groups() -> Array:
	return world().get("groups", []) if world_listed() else groups()


static func listed_peoples(group := "") -> Array:
	if not world_listed():
		return peoples(group)
	var out := []
	for p: Dictionary in world().get("peoples", []):
		if group.is_empty() or p.get("group", "") == group:
			out.append(p)
	return out


## Whether people `id` is one the creator lists now.
static func is_listed(id: String) -> bool:
	return is_world(id) if world_listed() else not people(id).is_empty()


## The eye colours the world adds to the body's (name -> "#rrggbb").
static func world_eye_colors() -> Dictionary:
	return world().get("eye_colors", {})


## A world people's mark in the skin ({kind, label, color, glow, default, note}; {} none): the look's people's.
static func trait_of(look: Dictionary) -> Dictionary:
	var t: Variant = people(String(look.get("people", ""))).get("trait")
	return t if t is Dictionary else {}


## A world people as the rest of the game reads a people: the face's mean and spread over every real people (so the
## fine-tune sliders and a mix have something to stand on), the hair texture, the men's genital size (the mean).
static func _derive(p: Dictionary) -> Dictionary:
	var out := p.duplicate(true)
	var real: Array = data().get("peoples", [])
	var mean := {}
	var sd := {}
	var gen := 0.0
	if not real.is_empty():
		for k in feature_keys():
			var s := 0.0
			var s2 := 0.0
			for r: Dictionary in real:
				var m := float((r.get("face_mean", {}) as Dictionary).get(k, 0.0))
				var d := float((r.get("face_sd", {}) as Dictionary).get(k, 0.3))
				s += m
				s2 += m * m + d * d
			var n := float(real.size())
			mean[k] = s / n
			sd[k] = sqrt(maxf(s2 / n - (s / n) * (s / n), 0.0))
		for r: Dictionary in real:
			gen += float(r.get("genital", 0.0))
		gen /= float(real.size())
	out["face_mean"] = mean
	out["face_sd"] = sd
	out["world"] = true
	if not out.has("genital"):
		out["genital"] = snappedf(gen, 0.001)
	if not out.has("hair_texture"):
		out["hair_texture"] = "any"
	if not out.get("hair_styles") is Dictionary:
		out["hair_styles"] = {"m": [], "f": []}
	return out


## A world people's faces from list `list` ("presets" or "stylized_presets") for body type `sex`: WORLD_PER_GROUP from
## each region of the real peoples, a different pick for each world people, so each shows faces of every ancestry.
static func _world_faces(pid: String, sex: float, list: String) -> Array:
	if _group_of.is_empty():
		for p: Dictionary in data().get("peoples", []):
			_group_of[String(p.get("id", ""))] = String(p.get("group", ""))
	var all: Array = data().get(list, [])
	var out := []
	# each people's list starts in a different region (its first face, the creator's default, not always Europe's)
	var gs := groups()
	var start := absi(hash(pid)) % maxi(gs.size(), 1)
	for gi in gs.size():
		var g := String(gs[(start + gi) % gs.size()])
		var pool := []
		for pr: Dictionary in all:
			if sex >= 0.0 and absf(float(pr.get("sex", 0.0)) - sex) > 0.5:
				continue
			if String(_group_of.get(String(pr.get("people", "")), "")) == g:
				pool.append(pr)
		if pool.is_empty():
			continue
		var h := absi(hash("%s:%s:%s" % [pid, g, list]))
		var step := maxi(1, pool.size() / WORLD_PER_GROUP)
		var taken := {}
		for i in mini(WORLD_PER_GROUP, pool.size()):
			var pr: Dictionary = pool[(h + i * step) % pool.size()]
			if not taken.has(pr.id):
				taken[pr.id] = true
				out.append(pr)
	return out


static func presets(people_id := "", sex := -1.0) -> Array:
	if not people_id.is_empty() and is_world(people_id):
		return _world_faces(people_id, sex, "presets")
	var out := []
	for pr: Dictionary in data().get("presets", []):
		if not people_id.is_empty() and pr.get("people", "") != people_id:
			continue
		if sex >= 0.0 and absf(float(pr.get("sex", 0.0)) - sex) > 0.5:
			continue
		out.append(pr)
	return out


static func preset(id: String) -> Dictionary:
	for list in ["presets", "stylized_presets"]:
		for pr: Dictionary in data().get(list, []):
			if pr.get("id", "") == id:
				return pr
	return {}


## The stylized example individuals of a people and body type (every one when empty / -1).
static func stylized_presets(people_id := "", sex := -1.0) -> Array:
	if not people_id.is_empty() and is_world(people_id):
		return _world_faces(people_id, sex, "stylized_presets")
	var out := []
	for pr: Dictionary in data().get("stylized_presets", []):
		if not people_id.is_empty() and pr.get("people", "") != people_id:
			continue
		if sex >= 0.0 and absf(float(pr.get("sex", 0.0)) - sex) > 0.5:
			continue
		out.append(pr)
	return out


## Look dictionary (BodyMaterials.apply_look keys) of a preset.
static func preset_look(id: String) -> Dictionary:
	var pr := preset(id)
	if pr.is_empty():
		return {}
	var look := {
		"people": pr.people, "preset": pr.id, "sex": float(pr.sex), "face": (pr.face as Dictionary).duplicate(),
		"melanin": float(pr.melanin), "undertone": String(pr.undertone), "haemoglobin": float(pr.haemoglobin),
		"freckles": float(pr.get("freckles", 0.0)), "iris": String(pr.iris), "stubble": float(pr.get("stubble", 0.0)),
		"stature": float(pr.get("stature", 1.0)), "hair": (pr.hair as Dictionary).duplicate(),
		"brows": (pr.get("brows", {}) as Dictionary).duplicate(),
	}
	if pr.has("face_style"):
		look["face_style"] = String(pr.face_style)
	if pr.has("facial_hair"):
		look["facial_hair"] = String(pr.facial_hair)
	if pr.has("genital"):
		look["genital"] = float(pr.genital)
	return look


static func _pick(dist: Dictionary, rng: RandomNumberGenerator) -> String:
	var keys := dist.keys()
	keys.sort()
	var total := 0.0
	for k in keys:
		total += float(dist[k])
	var r := rng.randf() * total
	for k in keys:
		r -= float(dist[k])
		if r <= 0.0:
			return String(k)
	return String(keys.back()) if not keys.is_empty() else ""


## A new individual of `people_id` (optionally mixed with `mix_id` by `mix` 0..1): face
## weights = mean + spread x normal noise (clamped), skin, eyes and hair drawn from the
## people's ranges and frequencies. Deterministic for a seeded rng.
static func random_look(people_id: String, sex: float, rng: RandomNumberGenerator, mix_id := "",
		mix := 0.0) -> Dictionary:
	var a := people(people_id)
	if a.is_empty():
		return {}
	var b := people(mix_id) if not mix_id.is_empty() else {}
	var t := clampf(mix, 0.0, 1.0) if not b.is_empty() else 0.0
	# a world people's face is any real people's (one drawn for the face and the body); its colours and styles its own
	var fa := a
	var real: Array = data().get("peoples", [])
	if bool(a.get("world", false)) and not real.is_empty():
		fa = real[rng.randi() % real.size()]
	var face := {}
	for f: Dictionary in features():
		var k := String(f.key)
		var m := lerpf(float(fa.face_mean.get(k, 0.0)), float(b.get("face_mean", {}).get(k, 0.0)), t)
		var sd := float(fa.face_sd.get(k, 0.3))
		var v := clampf(m + sd * rng.randfn(0.0, 0.8), -1.0, 1.0)
		if absf(v) > 0.001:
			face[k] = snappedf(v, 0.001)
	var src: Dictionary = a if rng.randf() >= t else b
	var mel_a: Array = a.skin.melanin
	var mel_b: Array = b.get("skin", a.skin).melanin
	var lo := lerpf(float(mel_a[0]), float(mel_b[0]), t)
	var hi := lerpf(float(mel_a[1]), float(mel_b[1]), t)
	var hb: Array = src.skin.haemoglobin
	var sx := "m" if sex >= 0.5 else "f"
	var styles: Array = (src.hair_styles as Dictionary).get(sx, [])
	var fr: Array = src.skin.get("freckles", [0.0, 0.0])
	# the men's genital size: the people's number (peoples.json; tools/character/body/peoples.py GENITAL),
	# a mix between the two peoples' numbers
	var g := lerpf(float(fa.get("genital", 0.0)), float(b.get("genital", fa.get("genital", 0.0))), t)
	var look := {
		"people": people_id, "mix": mix_id, "mix_amount": t, "sex": sex, "face": face,
		"melanin": snappedf(rng.randf_range(lo, hi), 0.001), "undertone": _pick(src.skin.undertone, rng),
		"haemoglobin": snappedf(rng.randf_range(float(hb[0]), float(hb[1])), 0.001),
		"freckles": snappedf(float(fr[1]) * rng.randf(), 0.001),
		"iris": _pick(src.eyes, rng),
		"hair": {"style": String(styles[rng.randi() % styles.size()]) if not styles.is_empty() else "hair_cropped_1758",
				"color": _pick(src.hair_colors, rng)},
		"brows": {"thickness": snappedf((0.55 + 0.35 * rng.randf()) if sex >= 0.5 else (0.35 + 0.25 * rng.randf()), 0.001),
				"arch": snappedf((0.55 if sex < 0.5 else 0.25) + 0.3 * (rng.randf() - 0.5), 0.001)},
		"stubble": snappedf(0.15 + 0.35 * rng.randf(), 0.001) if sex >= 0.5 else 0.0,
		"stature": snappedf((1.07 if sex >= 0.5 else 1.0) + 0.03 * (rng.randf() - 0.5), 0.001),
		# the body (BodyMaterials bust / genital)
		"bust": snappedf(clampf(rng.randfn(0.0, 0.35), -1.0, 0.75), 0.001) if sex < 0.5 else 0.0,
		"genital": snappedf(clampf(g, -1.0, 1.0), 0.001) if sex >= 0.5 else 0.0,
	}
	# a world people's weathering and its mark in the skin, near its own
	if a.has("weathering"):
		look["weathering"] = snappedf(clampf(float(a.weathering) + 0.15 * (rng.randf() - 0.5), 0.0, 1.0), 0.001)
	var tr: Variant = a.get("trait")
	if tr is Dictionary:
		look["trait"] = snappedf(clampf(float((tr as Dictionary).get("default", 0.5)) + 0.4 * (rng.randf() - 0.5), 0.0, 1.0), 0.001)
	return look
