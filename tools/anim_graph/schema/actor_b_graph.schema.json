{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "frontier/animations/actor_b_graph.schema.json",
 "title": "Actor_B animation graph export (tools/anim_graph/export_actor_b_graph.py)",
 "description": "Contract between WP1 (exporter) and the runtime (AnimGraphData, LocoBrain, UpperBody). Validated by tools/anim_graph/tests/test_export.py with a stdlib validator that supports: type, required, properties, additionalProperties, patternProperties, items, enum, const, pattern, minimum, maximum, minItems, $ref (#/definitions/...).",
 "type": "object",
 "required": ["meta", "profiles", "selections", "modes", "clips", "roles", "bank_roles", "aim_trees", "aim_move", "hand_states",
              "crouch_change", "grips", "actions", "runtime_clips", "runtime_roles", "transitions", "gates", "graph_states",
              "thresholds", "landing", "tuning", "tuning_notes", "options", "options_notes", "gameplay_overrides", "allowed_missing", "frontier",
              "weapon_layers"],
 "additionalProperties": false,
 "properties": {
  "meta": {
   "type": "object",
   "required": ["schema", "generator", "resolver", "resolver_compare", "resolver_policy", "resolver_exceptions", "resolver_disagreements", "authorization",
                "fidelity_policy", "generated_from", "vendored", "warnings", "coverage", "slot_basis", "keyed_bones", "superseded_by"],
   "properties": {
    "schema": {"const": 1},
    "generator": {"type": "string"},
    "resolver": {"enum": ["asc_fix", "asc_once"]},
    "resolver_compare": {"enum": ["asc_fix", "asc_once"]},
    "resolver_policy": {"type": "object", "required": ["loop", "compare", "why", "evidence"],
      "properties": {"loop": {"enum": ["asc_fix", "asc_once"]}, "compare": {"enum": ["asc_fix", "asc_once"]}, "why": {"type": "string"},
                     "evidence": {"type": "array", "items": {"type": "string"}}}},
    "resolver_exceptions": {"type": "array", "items": {"type": "object",
      "required": ["where", "use", "export_loop", "basis", "requirement", "enabled", "graph_result", "used_result", "prop_exempt_when_disabled",
                   "prop_full_weight_only_via_this_choice", "why"],
      "properties": {"where": {"type": "string"}, "use": {"enum": ["asc_fix", "asc_once"]}, "basis": {"const": "frontier_requirement"},
                     "requirement": {"type": "string"}, "enabled": {"const": true}, "why": {"type": "string"},
                     "prop_exempt_when_disabled": {"type": "array", "items": {"type": "string"}},
                     "prop_full_weight_only_via_this_choice": {"type": "object", "required": ["count", "roles"]}}}},
    "resolver_disagreements": {"type": "array", "items": {"type": "object", "required": ["where", "asc_fix", "asc_once", "chosen", "basis", "why"],
      "properties": {"where": {"type": "string"}, "chosen": {"enum": ["asc_fix", "asc_once"]},
                     "basis": {"enum": ["resolver_policy", "frontier_requirement"]}, "why": {"type": "string"}}}},
    "keyed_bones": {"type": "object", "required": ["file", "generator", "library_sha256"]},
    "slot_notes": {"type": "object", "additionalProperties": {"type": "string"}},
    "superseded_by": {"type": "string"},
    "authorization": {"type": "string", "pattern": "^owner-stated"},
    "fidelity_policy": {"type": "string"},
    "generated_from": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "vendored": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "coverage": {"type": "object", "patternProperties": {"^[a-z]+/[a-z]+$": {
      "type": "object", "required": ["resolved", "substitute", "missing", "direct"],
      "properties": {"resolved": {"type": "integer", "minimum": 0},
                     "substitute": {"type": "array", "items": {"type": "string"}},
                     "missing": {"type": "array", "items": {"type": "string"}},
                     "direct": {"type": "array", "items": {"type": "string"}}}}},
     "additionalProperties": false},
    "slot_basis": {"type": "string"},
    "units": {"type": "object"},
    "fixture": {"type": "object"}
   }
  },
  "profiles": {"type": "object", "additionalProperties": {
   "type": "object", "required": ["weapon-base", "weapon-sub-type", "weapon-draw-holster", "priorities"],
   "properties": {"weapon-base": {"type": "string"}, "weapon-sub-type": {"type": ["string", "null"]},
                  "weapon-draw-holster": {"type": "string"}, "alt_sub_type": {"type": "string"}, "priorities": {"type": "object"}}}},
  "selections": {"type": "object", "patternProperties": {"^[a-z]+/[a-z]+$": {"type": "object", "additionalProperties": {"type": "string"}}},
                 "additionalProperties": false},
  "modes": {"type": "object", "additionalProperties": {
   "type": "object", "required": ["mode", "mode_record", "overlays", "move_overlay", "move_overlay_id", "crouch", "sprint", "mode_speed", "stance"],
   "properties": {"mode": {"type": "string"}, "mode_record": {"type": "string", "pattern": "^0x[0-9a-f]{8}$"},
                  "overlays": {"type": "array", "items": {"type": "string"}}, "move_overlay": {"type": "string"},
                  "move_overlay_id": {"type": "string", "pattern": "^[0-9a-f]{8}$"}, "crouch": {"type": "boolean"},
                  "sprint": {"type": "boolean"}, "mode_speed": {"type": "number"}, "stance": {"enum": ["stand", "crouch"]}}}},
  "clips": {"type": "object", "additionalProperties": {"$ref": "#/definitions/Clip"}},
  "roles": {"type": "object", "patternProperties": {"^[a-z]+/[a-z]+/[a-z0-9_]+$": {"$ref": "#/definitions/Role"}}, "additionalProperties": false},
  "bank_roles": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}, "minItems": 3}},
  "aim_trees": {"type": "object", "patternProperties": {"^[a-z]+/(stand|crouch)$": {
   "type": "object", "required": ["base", "up", "down", "blocked", "arms_relaxed", "hands"],
   "properties": {"base": {"$ref": "#/definitions/Role"}, "up": {"$ref": "#/definitions/Role"}, "down": {"$ref": "#/definitions/Role"},
                  "blocked": {"$ref": "#/definitions/Role"}, "arms_relaxed": {"$ref": "#/definitions/Role"},
                  "hands": {"type": "object", "required": ["clip", "status", "layer"],
                            "properties": {"clip": {"type": ["string", "null"]}, "status": {"enum": ["resolved", "missing"]}}}}}},
   "additionalProperties": false},
  "carry_overrides": {"type": "object", "required": ["about", "poses", "rows"],
                      "properties": {"about": {"type": "string"}, "poses": {"type": "object"}, "rows": {"type": "object"}}},
  "action_overrides": {"type": "object", "required": ["about", "rows"],
                       "properties": {"about": {"type": "string"}, "rows": {"type": "object"}}},
  "throw": {"type": "object",
            "properties": {"about": {"type": "string"}, "profiles": {"type": "array", "items": {"type": "string"}},
                           "states": {"type": "object"}, "allowed_missing": {"type": "array", "items": {"type": "string"}},
                           "missing_notes": {"type": "object"}, "clip_sets": {"type": "object"},
                           "release": {"type": "object", "required": ["part", "clip_s", "chain_phase", "source"],
                                       "properties": {"part": {"type": "string"}, "clip_s": {"type": "number", "minimum": 0},
                                                      "chain_phase": {"type": "number", "minimum": 0, "maximum": 1}}},
                           "rows": {"type": "object", "patternProperties": {"^[a-z]+/(stand|crouch)$": {
                               "type": "object", "required": ["parts", "selection_mode"],
                               "properties": {"parts": {"type": "object", "additionalProperties": {"$ref": "#/definitions/Role"}},
                                              "selection_mode": {"type": "string"}}}}, "additionalProperties": false}}},
  "aim_move": {"type": "object", "patternProperties": {"^[a-z]+/(stand|crouch)$": {"type": "object", "additionalProperties": {"$ref": "#/definitions/Role"}}},
               "additionalProperties": false},
  "hand_states": {"type": "object", "patternProperties": {"^[a-z]+/(stand|crouch)$": {"type": "object", "additionalProperties": {"$ref": "#/definitions/Role"}}},
                  "additionalProperties": false},
  "crouch_change": {"type": "object", "patternProperties": {"^[a-z]+/(stand_to_crouch|crouch_to_stand)$": {
   "type": "object", "required": ["full", "add", "overlay", "mode"],
   "properties": {"full": {"$ref": "#/definitions/Role"}, "add": {"$ref": "#/definitions/Role"}, "overlay": {"type": "string"}, "mode": {"type": "string"}}}},
   "additionalProperties": false},
  "grips": {"type": "object", "additionalProperties": {
   "type": "object", "required": ["carry", "aim_stand", "aim_crouch", "sources"],
   "properties": {"carry": {"type": "string"}, "aim_stand": {"type": "string"}, "aim_crouch": {"type": "string"}, "sources": {"type": "object"}, "why": {"type": "string"}}}},
  "actions": {"type": "object", "patternProperties": {"^[a-z]+/(stand|crouch)/[a-z_]+$": {"$ref": "#/definitions/Action"}}, "additionalProperties": false},
  "runtime_clips": {
   "type": "object", "required": ["fire", "hit_full", "hit_add", "hit_add_by_stance", "death", "charge", "sources"],
   "properties": {
    "fire": {"type": "object", "patternProperties": {"^[a-z]+/(stand|crouch)$": {"type": "string"}}, "additionalProperties": false},
    "hit_full": {"type": "object", "patternProperties": {"^(stand|crouch)/(fw|bw|lt|rt)$": {"type": "string"}}, "additionalProperties": false},
    "hit_add": {"type": "object", "patternProperties": {"^(fw|bw|lt|rt)$": {"type": "string"}}, "additionalProperties": false},
    "hit_add_by_stance": {"type": "object", "patternProperties": {"^(stand|crouch)/(fw|bw|lt|rt)$": {"type": "string"}}, "additionalProperties": false},
    "death": {"type": "object", "required": ["front", "back", "crouch", "generic"], "additionalProperties": {"type": "string"}},
    "charge": {"type": "object", "additionalProperties": {"type": "string"}},
    "sources": {"type": "object"}, "why": {"type": "string"}}},
  "runtime_roles": {"type": "object", "required": ["hit_full", "hit_add", "death", "fire"],
                    "additionalProperties": {"type": "object", "additionalProperties": {"$ref": "#/definitions/Role"}}},
  "transitions": {"type": "object", "patternProperties": {"^[a-z0-9_]+$": {"$ref": "#/definitions/Transition"}}, "additionalProperties": false},
  "gates": {"type": "object", "additionalProperties": {"type": "object", "required": ["use_s", "frames", "fps", "graph_condition"],
            "properties": {"use_s": {"type": "number", "minimum": 0}}}},
  "graph_states": {"type": "object", "additionalProperties": {"$ref": "#/definitions/GraphState"}},
  "thresholds": {"type": "object", "required": ["hemi_enter_deg", "hemi_to_bw_deg", "hemi_to_fw_deg", "land_idle_exit_phase", "land_run_exit_phase",
                                                "land_move_gate", "hit_full_exit_phase", "hit_par_exit_phase", "idle_turn_enter_deg",
                                                "idle_turn_exit_deg", "turn_180_deg"]},
  "landing": {"type": "object", "required": ["medium_impact_mps", "hard_impact_mps", "jump_land_window_s", "status", "why", "bands", "directions",
                                             "select", "fallback", "never_selected", "not_exported", "derived"],
              "properties": {"medium_impact_mps": {"type": "number", "minimum": 0}, "hard_impact_mps": {"type": "number", "minimum": 0},
                             "status": {"const": "proposed"},
                             "select": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {
                               "type": "object", "additionalProperties": {"type": "string", "pattern": "^land_[a-z_]+$"}}}},
                             "fallback": {"type": "object", "additionalProperties": {"type": "string"}},
                             "derived": {"type": "object", "required": ["backward_deg", "jump_land_phase", "graph_landing_states"]}}},
  "tuning": {"type": "object"},
  "tuning_notes": {"type": "object", "properties": {"_about": {"type": "string"}},
                   "additionalProperties": {"type": "object", "required": ["status", "why"],
                                            "properties": {"status": {"enum": ["proposed", "approximation", "frontier"]}, "why": {"type": "string"}}}},
  "options": {"type": "object", "required": ["use_transition_anims", "idle_turns", "holster", "crouch_change_add", "crouch_change_full_body",
                                             "weapon_out_fingers", "blocked", "aim_walk", "pistol_sub_type"],
              "properties": {"use_transition_anims": {"type": "boolean"}, "idle_turns": {"type": "boolean"}, "holster": {"type": "boolean"},
                             "crouch_change_add": {"type": "boolean"}, "crouch_change_full_body": {"type": "boolean"},
                             "weapon_out_fingers": {"type": "boolean"}, "blocked": {"type": "boolean"}, "aim_walk": {"type": "boolean"},
                             "pistol_sub_type": {"enum": ["revolver", "pistol-actor_b"]}}},
  "options_notes": {"type": "object", "additionalProperties": {"type": "string"}},
  "gameplay_overrides": {"type": "object", "patternProperties": {"^override_[a-z_]+$": {
   "type": "object", "required": ["rule", "default", "why"],
   "properties": {"rule": {"type": "string"}, "default": {"const": false}, "why": {"type": "string"},
                  "transitions": {"type": "object"}, "sets_options": {"type": "object"}}}},
   "additionalProperties": false},
  "allowed_missing": {"type": "array", "items": {"type": "string"}},
  "weapon_layers": {"type": "object", "required": ["order", "weapon_out", "prop_bones", "notes"],
   "properties": {"order": {"type": "array", "items": {"type": "string"}, "minItems": 3},
                  "weapon_out": {"type": "object", "required": ["state", "state_offset", "entered_by", "loop", "option", "default_on", "weight",
                                                                "weight_source", "applies_to", "apply_rule", "apply_rule_why", "force", "clips"],
                                 "properties": {"weight": {"type": "number", "minimum": 0, "maximum": 1}, "default_on": {"type": "boolean"},
                                                "clips": {"type": "object", "patternProperties": {"^[a-z]+/(stand|crouch)$": {
                                                  "type": "object", "required": ["clip", "graph_clip", "status", "applies", "applies_why", "weapon_base_records",
                                                                                 "prop_bones_keyed", "resolution"],
                                                  "properties": {"clip": {"type": ["string", "null"]}, "applies": {"type": "boolean"},
                                                                 "resolution": {"enum": ["unique", "ambiguous"]},
                                                                 "resolver_basis": {"enum": ["resolver_policy", "frontier_requirement"]}}}},
                                                          "additionalProperties": false}}},
                  "prop_bones": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[lr]_hand_prop_attachment$"}},
                  "notes": {"type": "array", "items": {"type": "string"}}}},
  "frontier": {"type": "object", "required": ["relaxed_table_diff", "clip_table_diff", "weapon_tables_sha256"],
               "properties": {"relaxed_table_diff": {"type": "array", "items": {"type": "object", "required": ["weapon", "band", "frontier", "graph", "match"]}},
                              "clip_table_diff": {"type": "array", "items": {"type": "object", "required": ["weapon", "key", "frontier", "graph", "match"]}}}}
 },
 "definitions": {
  "Hex8": {"type": "string", "pattern": "^[0-9a-f]{8}$"},
  "Offset": {"type": "string", "pattern": "^0x[0-9a-f]{8}$"},
  "Clip": {
   "type": "object",
   "required": ["godot", "original_name", "native_asset_id", "length", "additive", "bone_count", "source_names", "alternatives", "graph_names"],
   "properties": {"godot": {"type": "string", "pattern": "^actor_b/"}, "original_name": {"type": "string"},
                  "native_asset_id": {"type": "string", "pattern": "^(stream_)?[0-9a-f]{64}$"}, "length": {"type": "number", "minimum": 0},
                  "additive": {"type": "boolean"}, "bone_count": {"type": "integer", "minimum": 0},
                  "source_names": {"type": "array", "items": {"type": "string"}}, "alternatives": {"type": "array", "items": {"type": "string"}},
                  "graph_names": {"type": "array", "items": {"type": "string"}}}},
  "ChainStep": {
   "type": "object", "required": ["layer", "set", "record_offset", "from_id", "to_id", "from", "to"],
   "additionalProperties": false,
   "properties": {"layer": {"type": "string"}, "set": {"type": "string"}, "record_offset": {"$ref": "#/definitions/Offset"},
                  "from_id": {"$ref": "#/definitions/Hex8"}, "to_id": {"$ref": "#/definitions/Hex8"}, "from": {"type": "string"}, "to": {"type": "string"}}},
  "Layer": {
   "type": "object",
   "required": ["slot", "kind", "clip", "graph_clip", "status", "weight", "weight_source", "weight_curve", "key", "set", "record_offset", "flags", "superseded_by", "sources"],
   "properties": {
    "slot": {"enum": ["hands", "arms", "arms_add", "spine_add", "other_partial", "other_add", "full_body", null]},
    "kind": {"enum": ["partial", "additive", null]}, "clip": {"type": ["string", "null"]}, "graph_clip": {"type": "string"},
    "status": {"enum": ["resolved", "missing", "substitute", "frontier"]},
    "weight": {"type": "number", "minimum": 0, "maximum": 1}, "weight_source": {"type": "string"},
    "weight_curve": {"type": ["array", "null"], "items": {"type": "number"}}, "weight_expr": {"type": ["string", "null"]},
    "key": {"enum": ["source", "intermediate", "final", "state", "frontier"]}, "set": {"type": ["string", "null"]},
    "record_offset": {"type": ["string", "null"], "pattern": "^0x[0-9a-f]{8}$"},
    "flags": {"type": ["string", "null"], "pattern": "^[0-9a-f]{2} [0-9a-f]{2} [0-9a-f]{2} [0-9a-f]{2}$"},
    "sample_s": {"type": "number", "minimum": 0}, "bones": {"type": "array", "items": {"type": "string"}},
    "frontier": {"type": "object", "required": ["pose", "why"]}, "carry_row": {"type": "string"},
    "carry_profile": {"type": "object", "required": ["weapon-base", "role"]}, "reason": {"type": "string"},
    "superseded_by": {"enum": ["hands", null]}, "excluded": {"type": "string"},
    "keyed_bone_count": {"type": "integer", "minimum": 0}, "prop_bones_keyed": {"type": "array", "items": {"type": "string"}},
    "slot_note": {"type": "string"}, "resolver_alternatives": {"type": "object"},
    "sources": {"type": "array", "items": {"type": "object", "required": ["set", "record_offset", "from_id", "to_id", "key", "weight"]}}}},
  "Role": {
   "type": "object",
   "required": ["state", "graph_clip", "chain", "layers", "clip", "status", "loop"],
   "properties": {
    "state": {"type": ["string", "null"]}, "state_offset": {"type": ["string", "null"]}, "leaf": {"type": ["string", "null"]},
    "leaf_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{8}$"}, "final_id": {"type": ["string", "null"]},
    "graph_clip": {"type": "string"}, "chain": {"type": "array", "items": {"$ref": "#/definitions/ChainStep"}},
    "layers": {"type": "array", "items": {"$ref": "#/definitions/Layer"}},
    "clip": {"type": ["string", "null"]}, "status": {"enum": ["resolved", "substitute", "missing", "direct", "disabled"]},
    "reason": {"type": "string"}, "loop": {"type": "boolean"}, "phase": {"type": "number"},
    "additive": {"type": ["boolean", "null"]},
    "resolution": {"const": "ambiguous"}, "resolver": {"enum": ["asc_fix", "asc_once"]}, "resolver_choice_why": {"type": "string"},
    "resolver_basis": {"enum": ["resolver_policy", "frontier_requirement"]},
    "resolver_alternatives": {"type": "object", "additionalProperties": {"type": "object", "required": ["clip", "graph_clip", "status", "chain", "layers"]}},
    "use_runtime_roles": {"type": "string", "pattern": "^runtime_roles\\.(hit_full|hit_add)\\."},
    "graph_leaf": {"type": "object", "required": ["clip", "graph_clip", "layers", "note"]},
    "prop": {"type": "object", "required": ["bone", "drivers", "full_weight"],
             "properties": {"bone": {"type": "string"}, "full_weight": {"type": "boolean"}, "exempt": {"type": "string"},
                            "drivers": {"type": "array", "items": {"type": "object", "required": ["clip", "weight", "min_weight", "source"],
                                        "properties": {"source": {"enum": ["role clip", "layer", "weapon_out"]}}}}}}}},
  "Action": {
   "type": "object",
   "required": ["state", "state_offset", "twin_state", "partial", "twin", "status", "loop", "partial_role", "twin_role"],
   "properties": {"state": {"type": "string"}, "twin_state": {"type": "string"}, "partial": {"type": ["string", "null"]},
                  "twin": {"type": ["string", "null"]}, "status": {"enum": ["resolved", "missing", "frontier_pinned", "frontier_substitute"]}, "loop": {"type": "boolean"},
                  "partial_role": {"$ref": "#/definitions/Role"}, "twin_role": {"$ref": "#/definitions/Role"},
                  "start_phase": {"type": "number"}, "by_mode": {"type": "object"},
                  "pinned_from": {"type": "string", "pattern": "^[a-z]+/(stand|crouch)/[a-z_]+$"}, "why": {"type": "string"},
                  "replaced": {"type": "object", "required": ["partial", "twin"]}, "substitute": {"type": "object"}}},
  "TransitionRecord": {
   "type": "object", "required": ["record", "order", "request", "target", "fade_s", "flags_0x04", "byte_0x28", "conditions", "condition_text"],
   "properties": {"record": {"$ref": "#/definitions/Offset"}, "order": {"type": "integer", "minimum": 0}, "request": {"type": "string"},
                  "target": {"type": "string"}, "fade_s": {"type": "number"}, "flags_0x04": {"type": "string", "pattern": "^[0-9a-f]{8}$"},
                  "byte_0x28": {"type": "string", "pattern": "^[0-9a-f]{2}$"}, "conditions": {"type": "array"}, "condition_text": {"type": "string"}}},
  "Transition": {
   "type": "object", "required": ["from", "to", "when", "status", "graph", "graph_variants", "use", "overrides"],
   "properties": {
    "status": {"enum": ["graph", "proposed", "substitute"]},
    "graph": {"type": ["object", "null"], "required": ["record", "source", "target", "request", "fade_s", "byte_0x28", "flags_0x04", "conditions"]},
    "graph_variants": {"type": "array", "items": {"$ref": "#/definitions/TransitionVariant"}},
    "use": {"$ref": "#/definitions/Use"},
    "use_basis": {"type": "string"},
    "overrides": {"type": "array", "items": {"type": "object", "required": ["flag", "rule", "why"],
                                             "properties": {"flag": {"type": "string", "pattern": "^override_"}, "rule": {"type": "string"}}}}}},
  "Use": {"type": "object",
   "properties": {"fade_s": {"type": "number", "minimum": 0}, "gate_s": {"type": "number", "minimum": 0},
                  "gate_frames": {"type": "number", "minimum": 0}, "gate_phase": {"type": "number", "minimum": 0},
                  "gate_phase_max": {"type": "number"}, "gate": {"type": "string"},
                  "gate_basis": {"type": "string"}, "gate_alternative": {"type": "string"},
                  "secondary_min": {"type": "number"}, "secondary_max": {"type": "number"},
                  "selector6_min": {"type": "number"}, "selector6_max": {"type": "number"}}},
  "TransitionVariant": {
   "type": "object", "required": ["record", "source", "target", "request", "fade_s", "order", "condition_text", "conditions", "use"],
   "properties": {"record": {"$ref": "#/definitions/Offset"}, "use": {"$ref": "#/definitions/Use"}}},
  "GraphState": {
   "type": "object", "required": ["state_offset", "tree", "callbacks", "tree_nodes", "transitions", "loop", "incoming_total", "entered_by"],
   "properties": {"state_offset": {"$ref": "#/definitions/Offset"}, "transitions": {"type": "array", "items": {"$ref": "#/definitions/TransitionRecord"}},
                  "tree_nodes": {"type": "array"}, "loop": {"type": "boolean"}}}
 }
}
