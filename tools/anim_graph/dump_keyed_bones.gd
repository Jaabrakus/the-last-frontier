extends SceneTree
## Writes tools/anim_graph/actor_b_keyed_bones.json: for every clip of the actor_b animation
## library, the set of skeleton bones it keys (any rotation, position or scale track). The WP1
## exporter (export_actor_b_graph.py) reads it to check layer slots against the real keyed bones
## and to assert that a weapon's prop bone is driven in every carry role.
##
##   Godot --headless --path . -s tools/anim_graph/dump_keyed_bones.gd [-- out=<path>] [-- check] [-- rig=<res path>]
##
## A rig that fails to load (or lacks Skeleton3D / AnimationPlayer / the actor_b library) prints
## "KEYED BONES FAILED: ..." and exits 1 instead of hanging (rig= exists to test that path).
##
## `check` recomputes the table and exits 1 unless the committed file has the same bones and
## clip masks (the library sha256 is informational and not compared, so a rig restamp that only
## changes skeleton metadata does not make the file stale).
##
## Mask format: one hex string per clip, nibble j covers bones 4j..4j+3 of `bones` (skeleton
## order), bit k of the nibble = bone 4j+k. Decode: for j, ch in enumerate(mask): v = int(ch, 16);
## bone 4j+k is keyed iff (v >> k) & 1.
##
## This tool only reads track paths.

const OUT := "res://tools/anim_graph/actor_b_keyed_bones.json"
const LIB := "res://animations/Actor_B.res"
const RIG := "res://characters/Actor_B.tscn"


func _fail(msg: String) -> void:
	push_error("dump_keyed_bones: " + msg)
	print("KEYED BONES FAILED: " + msg)
	quit(1)


func _initialize() -> void:
	var out_path := OUT
	var check := false
	var rig := RIG
	for a in OS.get_cmdline_user_args():
		if a.begins_with("out="):
			out_path = a.substr(4)
		elif a.begins_with("rig="):
			rig = a.substr(4)
		elif a == "check" or a == "--check":
			check = true
	# Every lookup is guarded: a SceneTree script that errors before quit() never exits.
	var ps: PackedScene = null
	if ResourceLoader.exists(rig):
		ps = load(rig) as PackedScene
	if ps == null:
		_fail("cannot load %s as a PackedScene" % rig)
		return
	var inst := ps.instantiate() as Node3D
	if inst == null:
		_fail("%s does not instantiate to a Node3D" % rig)
		return
	root.add_child(inst)
	var sk := inst.get_node_or_null("Skeleton3D") as Skeleton3D
	if sk == null:
		_fail("%s has no Skeleton3D child named 'Skeleton3D'" % rig)
		return
	var ap := inst.get_node_or_null("AnimationPlayer") as AnimationPlayer
	if ap == null:
		_fail("%s has no AnimationPlayer child named 'AnimationPlayer'" % rig)
		return
	if not ap.has_animation_library("actor_b"):
		_fail("the AnimationPlayer of %s has no 'actor_b' library" % rig)
		return
	var lib := ap.get_animation_library("actor_b")
	if lib == null or lib.get_animation_list().is_empty():
		_fail("the 'actor_b' library of %s is empty" % rig)
		return
	var bones: Array[String] = []
	for b in sk.get_bone_count():
		bones.append(sk.get_bone_name(b))
	var names: Array[String] = []
	for n: StringName in lib.get_animation_list():
		names.append(String(n))
	names.sort()
	var nib := (bones.size() + 3) / 4
	var lines: Array[String] = []
	lines.append("{")
	lines.append(" \"about\": %s," % JSON.stringify("Keyed skeleton bones per actor_b clip (rotation, position or scale track). Generated by tools/anim_graph/dump_keyed_bones.gd; do not edit."))
	lines.append(" \"mask_format\": %s," % JSON.stringify("hex string; nibble j covers bones 4j..4j+3 of 'bones'; bit k of nibble j = bone 4j+k keyed"))
	lines.append(" \"library\": %s," % JSON.stringify(LIB))
	lines.append(" \"library_sha256\": %s," % JSON.stringify(FileAccess.get_sha256(LIB)))
	lines.append(" \"bones\": %s," % JSON.stringify(bones))
	lines.append(" \"clips\": {")
	var masks := {}
	for i in names.size():
		var a := lib.get_animation(names[i])
		var bits := PackedByteArray()
		bits.resize(nib)
		bits.fill(0)
		for t in a.get_track_count():
			var ty := a.track_get_type(t)
			if ty != Animation.TYPE_ROTATION_3D and ty != Animation.TYPE_POSITION_3D and ty != Animation.TYPE_SCALE_3D:
				continue
			var b := sk.find_bone(str(a.track_get_path(t).get_concatenated_subnames()))
			if b < 0:
				continue
			bits[b / 4] = bits[b / 4] | (1 << (b % 4))
		var s := ""
		for j in nib:
			s += "0123456789abcdef"[bits[j]]
		masks[names[i]] = s
		lines.append("  %s: %s%s" % [JSON.stringify(names[i]), JSON.stringify(s), "," if i < names.size() - 1 else ""])
	lines.append(" }")
	lines.append("}")
	var txt := "\n".join(lines) + "\n"
	if check:
		var cur := FileAccess.get_file_as_string(out_path)
		var parsed = JSON.parse_string(cur) if cur != "" else null
		var ok: bool = parsed is Dictionary and parsed.get("bones", []) == bones and parsed.get("clips", {}) == masks
		print("KEYED BONES %s: %d clips, %d bones (%s)" % ["OK" if ok else "STALE", names.size(), bones.size(), out_path])
		quit(0 if ok else 1)
		return
	var f := FileAccess.open(out_path, FileAccess.WRITE)
	if f == null:
		push_error("cannot write %s" % out_path)
		quit(1)
		return
	f.store_string(txt)
	f.close()
	print("wrote %s: %d clips, %d bones" % [out_path, names.size(), bones.size()])
	quit(0)
