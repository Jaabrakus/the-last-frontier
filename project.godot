; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tidebreak"
config/description="Elemental arena combat. An early playable demo with four elements, aerial moves and water ring-outs."
; Preserve existing desktop saves, settings and character looks across the title change.
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Frontier"
config/custom_user_dir_name.linux="godot/app_userdata/Frontier"
run/main_scene="res://scenes/main_menu.tscn"
run/main_scene.public="res://scenes/ring.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.11, 0.145, 0.208, 1)
boot_splash/stretch_mode=4
boot_splash/image="res://assets/ui/tidebreak_splash.png"
boot_splash/minimum_display_time=1200

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[dotnet]

project/assembly_name="Frontier"

[editor_plugins]

enabled=PackedStringArray("res://addons/release_metadata/plugin.cfg")

[physics]

common/physics_ticks_per_second=120

[rendering]

textures/vram_compression/import_s3tc_bptc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
global_illumination/gi/use_half_resolution=true
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/use_debanding=true
occlusion_culling/use_occlusion_culling=true

[shader_globals]

veg_clear_a={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
veg_clear_b={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
veg_clear_c={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
veg_clear_d={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
skin_bounce={
"type": "float",
"value": 1.0
}
sky_time={
"type": "float",
"value": 0.0
}
sky_cloud_offset={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
softlook_ambient={
"type": "float",
"value": 0.45
}
wind_direction={
"type": "vec2",
"value": Vector2(0.866, -0.5)
}
